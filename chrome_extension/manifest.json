{
  "manifest_version": 3,
  "name": "Super Calculator Auto-Solve",
  "version": "2.0",
  "description": "Калькулятор для Chrome, который автоматически находит и решает математические задачи на любых сайтах",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "32": "icons/icon32.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["text_parser.js", "ai_solver.js", "auto_test_solver.js", "multi_tab_solver.js", "dom_analyzer.js", "biology_solver.js", "statistics_solver.js", "content.js", "universal_solver.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
    }
}
