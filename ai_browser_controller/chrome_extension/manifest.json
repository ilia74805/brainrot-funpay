{
  "manifest_version": 3,
  "name": "Mr. 7B - ИИ Умный Браузер",
  "version": "1.0.0",
  "description": "ИИ-ассистент с локальной моделью для полного управления браузером. Решает задачи, заполняет формы, анализирует страницы.",
  
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "nativeMessaging",
    "debugger"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "32": "icons/icon32.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  
  "commands": {
    "toggle_extension": {
      "suggested_keyboard_shortcuts": ["Ctrl+Shift+7"],
      "description": "Включить/отключить Mr. 7B"
    },
    "auto_solve": {
      "suggested_keyboard_shortcuts": ["Ctrl+Shift+8"],
      "description": "Автоматически решить все задачи на странице"
    },
    "ai_analyze": {
      "suggested_keyboard_shortcuts": ["Ctrl+Shift+9"],
      "description": "Проанализировать страницу с помощью ИИ"
    }
  }
}
