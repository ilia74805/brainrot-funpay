{
  "manifest_version": 3,
  "name": "Mr. 7B - AI Browser Controller",
  "version": "1.1.0",
  "description": "AI-powered browser automation with local LLM support. Solves academic problems, auto-fills forms, and manages browser tabs intelligently.",
  
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "nativeMessaging",
    "debugger",
    "notifications",
    "clipboardWrite",
    "clipboardRead",
    "alarms"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "32": "icons/icon32.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  
  "commands": {
    "toggle_extension": {
      "suggested_keyboard_shortcuts": ["Ctrl+Shift+7"],
      "description": "Toggle Mr. 7B on/off"
    },
    "auto_solve": {
      "suggested_keyboard_shortcuts": ["Ctrl+Shift+8"],
      "description": "Auto-solve all tasks on current page"
    },
    "ai_analyze": {
      "suggested_keyboard_shortcuts": ["Ctrl+Shift+9"],
      "description": "Analyze page with AI assistance"
    },
    "open_settings": {
      "suggested_keyboard_shortcuts": ["Ctrl+Shift+0"],
      "description": "Open Mr. 7B settings"
    }
  },
  
  "minimum_chrome_version": "90"
}
